{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "perf": "warn",
    "suspicious": "warn"
  },
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "jsdoc", "promise", "jest"],
  "rules": {
    "typescript/no-deprecated": "error"
  }
}
