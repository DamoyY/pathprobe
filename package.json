{
  "name": "pathprobe",
  "version": "1.10.15",
  "description": "Extract, resolve, and validate file and directory paths mentioned in text, with variable expansion, ignore rules, hidden-file control, and configurable search roots.",
  "license": "Apache-2.0",
  "repository": {
    "url": "git+https://github.com/DamoyY/pathprobe.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "jiti quality/tools/dispatch.mjs build",
    "format": "jiti quality/tools/dispatch.mjs format",
    "lint": "jiti quality/tools/dispatch.mjs lint",
    "prepack": "jiti quality/tools/dispatch.mjs build",
    "test": "jiti quality/tools/dispatch.mjs test",
    "test:benchmark": "jiti quality/tools/dispatch.mjs benchmark"
  },
  "dependencies": {
    "@monyone/aho-corasick": "latest",
    "globby": "latest",
    "is-path-inside": "latest",
    "koffi": "latest",
    "p-limit": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "jiti": "latest",
    "knip": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "oxlint-tsgolint": "latest",
    "std-env": "latest",
    "tinybench": "latest",
    "tsdown": "beta",
    "typescript": "next"
  },
  "engines": {
    "bun": ">=1.2.6",
    "node": ">=20.16.0"
  }
}
