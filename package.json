{
  "name": "pathprobe",
  "version": "0.5.3",
  "description": "Extract, resolve, and validate file and directory paths mentioned in text, with variable expansion, ignore rules, hidden-file control, and configurable search roots.",
  "license": "Apache-2.0",
  "repository": {
    "url": "https://github.com/DamoyY/pathprobe/"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --clean --no-dts --format esm --platform node --sourcemap --tsconfig tsconfig.json && tsc --project config/tsconfig.build.json",
    "format": "oxfmt --config config/oxfmt.json .",
    "lint": "oxlint --config config/oxlint.json --tsconfig tsconfig.json .",
    "prepack": "bun run build",
    "test": "node --test \"quality/test/*.test.mjs\" && bun test quality/test",
    "test:benchmark": "node quality/benchmark/run.mjs",
    "test:benchmark:bun": "bun quality/benchmark/run.mjs"
  },
  "dependencies": {
    "fast-glob": "latest",
    "globby": "latest",
    "koffi": "latest",
    "p-limit": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "tinybench": "latest",
    "tsdown": "latest",
    "typescript": "next"
  },
  "engines": {
    "node": ">=20"
  }
}
